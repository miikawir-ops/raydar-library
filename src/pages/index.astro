---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import T from '../components/T.astro';
import { tags, type TagId } from '../data/tags';
import { byNewest, shelfIndex, SHELVES } from '../lib/book';

const books = (await getCollection('books')).sort(byNewest);
// Books grouped onto their shelves (src/lib/book.ts); an empty shelf is not shown.
const shelves = SHELVES.map((shelf, index) => ({ ...shelf, index, books: books.filter((b) => shelfIndex(b) === index) }))
  .filter((shelf) => shelf.books.length > 0);
const usedTags = (Object.keys(tags) as TagId[]).filter((t) => books.some((b) => b.data.tags.includes(t)));
const hasHeroImage = existsSync('public/hero.webp');
const description = 'Tietokirjojen ydinsanomat selkeinä tiivistelminä, suomeksi ja englanniksi.';
---
<Base titleFi="RayDar Library" titleEn="RayDar Library" description={description} home>
  <section class:list={['hero', { 'has-image': hasHeroImage }]} slot="hero">
    {hasHeroImage && <div class="hero-media"><img class="hero-img" src="/hero.webp" alt="" fetchpriority="high" /></div>}
    <div class="hero-overlay" aria-hidden="true"></div>
    {hasHeroImage && (
      <div class="hero-motes" aria-hidden="true" data-anim>
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    )}
    <div class="hero-content">
      <div class="hero-text">
      <h1 class="hero-title" lang="en">Rime of the Ancient Mariner</h1>
      <p class="hero-lead">
        <span class="i18n" lang="fi">Tietokirjojen ydinsanomat suomeksi ja englanniksi – johdatuksia, jotka eivät korvaa kirjaa. <span class="hero-reco">Lämmin suositus: lue koko kirja!</span></span>
        <span class="i18n" lang="en">The core messages of non-fiction books in Finnish and English – introductions, not replacements. <span class="hero-reco">A warm recommendation: read the whole book!</span></span>
      </p>
      <p class="hero-motto" lang="en">Make everything as simple as possible, but not simpler.</p>
      {books.length > 0 && (
        <form class="search" role="search" data-search-form>
          <label class="visually-hidden" for="search-input"><T fi="Hae kirjastosta" en="Search the library" /></label>
          <input
            id="search-input"
            type="search"
            autocomplete="off"
            placeholder="Hae kirjoja, kirjoittajia tai aiheita"
            data-placeholder-fi="Hae kirjoja, kirjoittajia tai aiheita"
            data-placeholder-en="Search books, authors or topics"
          />
        </form>
      )}
      </div>
    </div>
  </section>

  {hasHeroImage && <div class="lamp-spill" aria-hidden="true" data-anim></div>}
  <div class="page">
    {books.length === 0 ? (
      <section class="state">
        <h2><T fi="Kirjasto avautuu pian" en="The library opens soon" /></h2>
        <p><T fi="Ensimmäiset tiivistelmät ovat vielä tulossa." en="The first summaries are still on their way." /></p>
      </section>
    ) : (
      <>
        <header class="collection-head">
          <h2 class="eyebrow"><T fi="Kokoelma" en="Collection" /></h2>
          <p class="collection-count"><T
            fi={books.length === 1 ? '1 kirja' : `${books.length} kirjaa`}
            en={books.length === 1 ? '1 book' : `${books.length} books`}
          /></p>
        </header>
        <div class="controls">
          <div class="filters" role="group" data-label-fi="Suodata aiheen mukaan" data-label-en="Filter by topic" aria-label="Suodata aiheen mukaan">
            <button type="button" class="chip" data-tag-filter="" aria-pressed="true"><T fi="Kaikki" en="All" /></button>
            {usedTags.map((t) => (
              <button type="button" class="chip" data-tag-filter={t} aria-pressed="false"><T fi={tags[t].fi} en={tags[t].en} /></button>
            ))}
          </div>
          <div class="controls-side">
            <label class="sort">
              <span class="visually-hidden"><T fi="Järjestys" en="Sort by" /></span>
              <select data-sort>
                <option value="added" data-text-fi="Uusimmat" data-text-en="Newest">Uusimmat</option>
                <option value="author" data-text-fi="Kirjoittaja" data-text-en="Author">Kirjoittaja</option>
                <option value="year" data-text-fi="Julkaisuvuosi" data-text-en="Publication year">Julkaisuvuosi</option>
              </select>
            </label>
            <button type="button" class="button" data-random><T fi="Satunnainen kirja" en="Random book" /></button>
          </div>
        </div>
        <p class="result-count" aria-live="polite" data-count></p>
        <!-- Shelves by topic. With a search or a tag filter the script moves the same cards into
             the plain grid below and hides the shelves; clearing them brings the shelves back. -->
        <div class="shelves" data-shelves>
          {shelves.map((shelf) => (
            <section class="shelf" data-hue={tags[shelf.hueTag].hue} aria-labelledby={`shelf-${shelf.id}`}>
              <header class="shelf-head">
                <h3 class="eyebrow" id={`shelf-${shelf.id}`}><T fi={shelf.fi} en={shelf.en} /></h3>
                <p class="shelf-count"><T
                  fi={shelf.books.length === 1 ? '1 kirja' : `${shelf.books.length} kirjaa`}
                  en={shelf.books.length === 1 ? '1 book' : `${shelf.books.length} books`}
                /></p>
              </header>
              <div class="shelf-frame" data-shelf-frame>
                <span class="shelf-board" aria-hidden="true"></span>
                <button type="button" class="shelf-arrow shelf-arrow-prev" data-shelf-prev hidden
                  data-label-fi={`${shelf.fi}: edelliset kirjat`} data-label-en={`${shelf.en}: previous books`} aria-label={`${shelf.fi}: edelliset kirjat`}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 3 5.5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <div class="shelf-track" data-shelf-track={shelf.index}>
                  {shelf.books.map((book) => <BookCard book={book} />)}
                </div>
                <button type="button" class="shelf-arrow shelf-arrow-next" data-shelf-next hidden
                  data-label-fi={`${shelf.fi}: seuraavat kirjat`} data-label-en={`${shelf.en}: next books`} aria-label={`${shelf.fi}: seuraavat kirjat`}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
              </div>
            </section>
          ))}
        </div>
        <section class="grid" data-grid hidden></section>
        <section class="state" data-no-results hidden>
          <h2><T fi="Ei tuloksia" en="No results" /></h2>
          <p><T fi="Kokeile toista hakusanaa tai poista suodattimet." en="Try another search term or clear the filters." /></p>
          <button type="button" class="button" data-clear><T fi="Tyhjennä suodattimet" en="Clear filters" /></button>
        </section>
      </>
    )}
  </div>
  <!-- A calm close after the last shelf: a hint of the desk and the lamp light, fading into navy. -->
  <div class="home-end" aria-hidden="true"></div>

  {books.length > 0 && (
    <script is:inline type="module">
      const grid = document.querySelector('[data-grid]');
      const shelvesEl = document.querySelector('[data-shelves]');
      const tracks = [...document.querySelectorAll('[data-shelf-track]')];
      const trackFor = Object.fromEntries(tracks.map((t) => [t.dataset.shelfTrack, t]));
      const cards = [...document.querySelectorAll('[data-card]')];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const input = document.querySelector('#search-input');
      const sort = document.querySelector('[data-sort]');
      const count = document.querySelector('[data-count]');
      const noResults = document.querySelector('[data-no-results]');
      const chips = [...document.querySelectorAll('[data-tag-filter]')];

      let activeTag = '';
      let searchHits = null; // null = no active search; otherwise a Set of page URLs
      let searchError = false;
      let searchRun = 0;
      let pagefind = null;

      const visibleCards = () => cards.filter((c) => !c.hidden);
      const isFiltered = () => Boolean(activeTag || searchHits);

      const comparators = {
        added: (a, b) => b.dataset.added.localeCompare(a.dataset.added),
        author: (a, b) => a.dataset.author.localeCompare(b.dataset.author, 'fi'),
        year: (a, b) => Number(b.dataset.year) - Number(a.dataset.year),
      };

      // Shelves: each card on its own shelf in the chosen order. Filtered: one plain grid, in shelf
      // order first (AI, psychology, the rest) and the chosen order within each shelf.
      function arrange() {
        const cmp = comparators[sort.value] || comparators.added;
        if (isFiltered()) {
          [...cards]
            .sort((a, b) => Number(a.dataset.shelf) - Number(b.dataset.shelf) || cmp(a, b))
            .forEach((c) => grid.append(c));
        } else {
          [...cards].sort(cmp).forEach((c) => trackFor[c.dataset.shelf].append(c));
        }
      }

      // Brass arrows on wide screens, only towards the side that still has books to scroll to.
      function updateArrows() {
        for (const track of tracks) {
          const frame = track.closest('[data-shelf-frame]');
          const prev = frame.querySelector('[data-shelf-prev]');
          const next = frame.querySelector('[data-shelf-next]');
          const max = track.scrollWidth - track.clientWidth;
          const showPrev = max > 2 && track.scrollLeft > 2;
          const showNext = max > 2 && track.scrollLeft < max - 2;
          // Show first, then move a keyboard user off an arrow that is about to disappear, then hide.
          if (showPrev) prev.hidden = false;
          if (showNext) next.hidden = false;
          if (!showPrev && document.activeElement === prev && showNext) next.focus();
          if (!showNext && document.activeElement === next && showPrev) prev.focus();
          prev.hidden = !showPrev;
          next.hidden = !showNext;
        }
      }
      let arrowsPending = false;
      const updateArrowsSoon = () => {
        if (arrowsPending) return;
        arrowsPending = true;
        requestAnimationFrame(() => { arrowsPending = false; updateArrows(); });
      };
      for (const track of tracks) {
        const frame = track.closest('[data-shelf-frame]');
        track.addEventListener('scroll', updateArrowsSoon, { passive: true });
        const step = (dir) => track.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: reduceMotion ? 'auto' : 'smooth' });
        frame.querySelector('[data-shelf-prev]').addEventListener('click', () => step(-1));
        frame.querySelector('[data-shelf-next]').addEventListener('click', () => step(1));
        // Keyboard: browsers leave a partly visible focused card where it is, so bring it fully in.
        track.addEventListener('focusin', (e) => {
          const card = e.target.closest('[data-card]');
          if (!card) return;
          const r = card.getBoundingClientRect();
          const tr = track.getBoundingClientRect();
          if (r.left < tr.left || r.right > tr.right) {
            card.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
          }
        });
      }
      addEventListener('resize', updateArrowsSoon);
      addEventListener('load', updateArrowsSoon);

      function render() {
        const filtered = isFiltered();
        for (const card of cards) {
          const tagOk = !activeTag || card.dataset.tags.split(' ').includes(activeTag);
          const searchOk = !searchHits || searchHits.has(card.dataset.url);
          card.hidden = filtered && !(tagOk && searchOk);
        }
        arrange();
        const n = visibleCards().length;
        shelvesEl.hidden = filtered;
        noResults.hidden = !filtered || n > 0 || searchError;
        grid.hidden = !filtered || n === 0;
        count.replaceChildren();
        const fi = document.createElement('span');
        const en = document.createElement('span');
        fi.className = en.className = 'i18n';
        fi.lang = 'fi';
        en.lang = 'en';
        // The collection heading already shows the total, so the count appears only when filtered.
        fi.textContent = searchError ? 'Haku ei ole juuri nyt käytettävissä.' : !filtered ? '' : n === 1 ? '1 kirja' : n + ' kirjaa';
        en.textContent = searchError ? 'Search is not available right now.' : !filtered ? '' : n === 1 ? '1 book' : n + ' books';
        count.append(fi, en);
        updateArrowsSoon();
      }

      sort.addEventListener('change', () => { arrange(); updateArrowsSoon(); });

      function setTag(tag) {
        activeTag = tag;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tagFilter === tag)));
        render();
      }
      chips.forEach((c) => c.addEventListener('click', () => setTag(c.dataset.tagFilter)));

      async function runSearch(query) {
        const run = ++searchRun;
        if (!query) {
          searchHits = null;
          searchError = false;
          render();
          return;
        }
        try {
          pagefind ??= await import('/pagefind/pagefind.js');
          const found = await pagefind.search(query);
          const data = await Promise.all(found.results.map((r) => r.data()));
          if (run !== searchRun) return;
          searchHits = new Set(data.map((d) => d.url));
          searchError = false;
        } catch (e) {
          if (run !== searchRun) return;
          searchHits = null;
          searchError = true;
        }
        render();
      }

      let timer;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => runSearch(input.value.trim()), 200);
      });
      document.querySelector('[data-search-form]').addEventListener('submit', (e) => {
        e.preventDefault();
        clearTimeout(timer);
        runSearch(input.value.trim());
      });

      document.querySelector('[data-clear]').addEventListener('click', () => {
        input.value = '';
        searchHits = null;
        setTag('');
      });

      document.querySelector('[data-random]').addEventListener('click', () => {
        const pool = visibleCards().length ? visibleCards() : cards;
        location.href = pool[Math.floor(Math.random() * pool.length)].dataset.url;
      });

      // Keep the collection view (filter, sort, search, page and shelf scroll positions) in this
      // history entry, so returning from a book page (the back button or the "Collection" link,
      // which uses history.back()) restores it even when the browser reloads the page instead of
      // using its back-forward cache. Writes are debounced: browsers limit how often replaceState may run.
      let saveTimer;
      const saveView = () => {
        try {
          const shelfX = Object.fromEntries(tracks.map((t) => [t.dataset.shelfTrack, Math.round(t.scrollLeft)]));
          history.replaceState({ ...(history.state || {}), collection: { tag: activeTag, sort: sort.value, q: input.value, y: Math.round(scrollY), shelfX } }, '');
        } catch (e) {}
      };
      const saveSoon = () => { clearTimeout(saveTimer); saveTimer = setTimeout(saveView, 250); };
      addEventListener('scroll', saveSoon, { passive: true });
      tracks.forEach((t) => t.addEventListener('scroll', saveSoon, { passive: true }));
      [sort, input, ...chips].forEach((el) => el.addEventListener('change', saveSoon));
      chips.forEach((c) => c.addEventListener('click', saveSoon));
      input.addEventListener('input', saveSoon);
      addEventListener('pagehide', () => { clearTimeout(saveTimer); saveView(); });
      [grid, shelvesEl].forEach((el) => el.addEventListener('click', () => { clearTimeout(saveTimer); saveView(); }, true));

      render();

      const saved = history.state && history.state.collection;
      if (saved) {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        if (saved.sort && comparators[saved.sort]) {
          sort.value = saved.sort;
          arrange();
        }
        if (saved.tag && chips.some((c) => c.dataset.tagFilter === saved.tag)) setTag(saved.tag);
        if (saved.shelfX) {
          for (const t of tracks) t.scrollLeft = saved.shelfX[t.dataset.shelfTrack] || 0;
          updateArrowsSoon();
        }
        const restoreScroll = () => requestAnimationFrame(() => window.scrollTo({ top: saved.y || 0, behavior: 'instant' }));
        if (saved.q) {
          input.value = saved.q;
          runSearch(saved.q).then(restoreScroll);
        } else {
          restoreScroll();
        }
      }
    </script>
  )}
</Base>
