---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
---
<Base titleFi="Sivua ei löytynyt | RayDar Library" titleEn="Page not found | RayDar Library">
  <div class="page">
    <section class="state state-404">
      <h1><T fi="Sivua ei löytynyt" en="Page not found" /></h1>
      <p><T fi="Etsimääsi sivua ei ole tässä kirjastossa." en="The page you are looking for is not in this library." /></p>
      <a class="button" href="/"><T fi="Takaisin kirjastoon" en="Back to the library" /></a>
    </section>
  </div>
</Base>
