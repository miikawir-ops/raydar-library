---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import Cover from '../components/Cover.astro';
import CoverGlow from '../components/CoverGlow.astro';
import T from '../components/T.astro';
import { tags } from '../data/tags';
import { coverSrc, md, mdInline, readingMinutes, type Book } from '../lib/book';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book, related: books.filter((b) => book.data.liittyvat.includes(b.id)) },
  }));
}

const { book, related } = Astro.props as { book: CollectionEntry<'books'>; related: Book[] };
const d = book.data;
const languages = [
  { code: 'fi', content: d.fi },
  { code: 'en', content: d.en },
] as const;

const hasKasitteet = d.fi.kasitteet.length > 0 || d.en.kasitteet.length > 0;
const hasSuositukset = d.fi.suositukset.length > 0 || d.en.suositukset.length > 0;
const hasHuomio = d.fi.huomio.length > 0 || d.en.huomio.length > 0;
const hasOmaHuomio = d.oma_huomio.trim().length > 0;

const toc = [
  { id: 'yleiskuva', fi: 'Yleiskuva', en: 'Overview', show: true },
  { id: 'viestit', fi: 'Keskeiset viestit', en: 'Key messages', show: true },
  { id: 'kasitteet', fi: 'Käsitteet', en: 'Concepts', show: hasKasitteet },
  { id: 'kirjoittaja', fi: 'Kirjoittaja', en: 'The author', show: true },
  { id: 'suositukset', fi: 'Kirjan suositukset', en: "The book's recommendations", show: hasSuositukset },
  { id: 'huomio', fi: 'Huomio', en: 'Note', show: hasHuomio },
  { id: 'oma-huomio', fi: 'Oma huomio', en: 'Personal note', show: hasOmaHuomio },
  { id: 'liittyvat', fi: 'Liittyvät kirjat', en: 'Related books', show: related.length > 0 },
  { id: 'lue-koko-kirja', fi: 'Lue koko kirja', en: 'Read the full book', show: true },
  { id: 'lahteet', fi: 'Lähteet', en: 'Sources', show: true },
].filter((item) => item.show);

// Library search on Finna by title and author. Punctuation is dropped from the query; the
// search form was checked to return the right book first for every book in the library.
const finnaQuery = `${(d.title_fi ?? d.title).replace(/[:,]/g, '')} ${d.author}`;
const finnaUrl = `https://www.finna.fi/Search/Results?lookfor=${encodeURIComponent(finnaQuery)}&type=AllFields`;

const varmuusEn = { korkea: 'high', kohtalainen: 'moderate', matala: 'low' }[d.varmuus];
const titleFi = `${d.title_fi ?? d.title} | RayDar Library`;
const titleEn = `${d.title} | RayDar Library`;
---
<Base titleFi={titleFi} titleEn={titleEn} description={d.fi.ydin} ogImage={coverSrc(d, 'L') ?? undefined} book>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <article class="book" data-pagefind-body data-hue={tags[d.tags[0]].hue}>
    <!-- The small M cover keeps the glow from becoming the largest contentful paint: the L cover
         loads through two redirects, and a blurred glow needs no detail. -->
    <div class="book-glow-wrap" data-anim aria-hidden="true"><CoverGlow book={d} size="M" class="book-glow" /></div>
    <!-- Back to the collection: a plain link to the home page; the script below turns it into
         history.back() when the reader came from the home page, so filters and scroll position return. -->
    <p class="back-nav back-nav-top" data-pagefind-ignore>
      <a class="back-link" href="/" data-back><T fi="← Kokoelma" en="← Collection" /></a>
    </p>
    <header class="book-head">
      <div class="book-cover"><Cover book={d} size="L" eager /></div>
      <div class="book-info">
        <h1 class="book-title">
          {d.title_fi ? <T fi={d.title_fi} en={d.title} /> : d.title}
        </h1>
        {d.title_fi && <p class="book-original i18n" lang="fi">Alkuteos: {d.title}</p>}
        <p class="book-author">{d.author} · {d.year}</p>
        <ul class="tag-list" data-pagefind-ignore>
          {d.tags.map((t) => <li class="tag" data-hue={tags[t].hue}><T fi={tags[t].fi} en={tags[t].en} /></li>)}
        </ul>
        <p class="book-marks" data-pagefind-ignore>
          <T fi={`Noin ${readingMinutes(d.fi)} min lukuaika`} en={`About ${readingMinutes(d.en)} min read`} />
          <span aria-hidden="true"> · </span>
          <T fi={`Varmuus: ${d.varmuus}`} en={`Confidence: ${varmuusEn}`} />
        </p>
      </div>
    </header>

    <div class="ydin">
      <div class="i18n" lang="fi" set:html={md(d.fi.ydin)} />
      <div class="i18n" lang="en" set:html={md(d.en.ydin)} />
    </div>
    <p class="read-full-hint" data-pagefind-ignore>
      <a href="#lue-koko-kirja"><T fi="Johdatus teokseen, ei korvaa kirjaa. Lue koko kirja ↓" en="An introduction, not a replacement. Read the full book ↓" /></a>
    </p>

    <details class="toc-mobile" data-pagefind-ignore>
      <summary><T fi="Sisällys" en="Contents" /></summary>
      <ul>{toc.map((item) => <li><a href={`#${item.id}`}><T fi={item.fi} en={item.en} /></a></li>)}</ul>
    </details>

    <div class="book-layout">
      <nav class="toc" data-pagefind-ignore data-label-fi="Sisällys" data-label-en="Contents" aria-label="Sisällys">
        <p class="toc-title"><T fi="Sisällys" en="Contents" /></p>
        <ul>{toc.map((item) => <li><a href={`#${item.id}`}><T fi={item.fi} en={item.en} /></a></li>)}</ul>
      </nav>

      <div class="book-text">
        <section id="yleiskuva">
          <h2><T fi="Yleiskuva" en="Overview" /></h2>
          {languages.map(({ code, content }) => <div class="prose i18n" lang={code} set:html={md(content.yleiskuva)} />)}
        </section>

        <section id="viestit">
          <h2><T fi="Keskeiset viestit" en="Key messages" /></h2>
          {languages.map(({ code, content }) => (
            <ol class="ideas i18n" lang={code}>
              {content.ideat.map((idea, i) => (
                <li class="idea">
                  <span class="idea-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3 set:html={mdInline(idea.otsikko)} />
                  <div class="prose" set:html={md(idea.selitys)} />
                </li>
              ))}
            </ol>
          ))}
        </section>

        {hasKasitteet && (
          <section id="kasitteet">
            <h2><T fi="Käsitteet" en="Concepts" /></h2>
            {languages.map(({ code, content }) => (
              <dl class="concepts i18n" lang={code}>
                {content.kasitteet.map((k) => (
                  <div>
                    <dt>{k.termi}</dt>
                    <dd set:html={md(k.selitys)} />
                  </div>
                ))}
              </dl>
            ))}
          </section>
        )}

        <section id="kirjoittaja">
          <h2><T fi="Kirjoittaja" en="The author" /></h2>
          {languages.map(({ code, content }) => <div class="prose i18n" lang={code} set:html={md(content.kirjoittaja)} />)}
        </section>

        {hasSuositukset && (
          <section id="suositukset">
            <h2><T fi="Kirjan suositukset" en="The book's recommendations" /></h2>
            {languages.map(({ code, content }) => (
              <ul class="prose recommendations i18n" lang={code}>
                {content.suositukset.map((s) => <li set:html={mdInline(s)} />)}
              </ul>
            ))}
          </section>
        )}

        {hasHuomio && (
          <section id="huomio" class="note">
            <h2><T fi="Huomio" en="Note" /></h2>
            {languages.map(({ code, content }) => (
              <div class="i18n" lang={code}>
                {content.huomio.map((h) => <div set:html={md(h)} />)}
              </div>
            ))}
          </section>
        )}

        {hasOmaHuomio && (
          <section id="oma-huomio" class="personal-note">
            <h2><T fi="Oma huomio" en="Personal note" /></h2>
            <div class="prose" set:html={md(d.oma_huomio)} />
          </section>
        )}

        {related.length > 0 && (
          <section id="liittyvat" data-pagefind-ignore>
            <h2><T fi="Liittyvät kirjat" en="Related books" /></h2>
            <div class="related">{related.map((b) => <BookCard book={b} />)}</div>
          </section>
        )}

        <section id="lue-koko-kirja" class="read-full" data-pagefind-ignore>
          <div class="read-full-cover"><Cover book={d} size="M" /></div>
          <div class="read-full-body">
            <h2><T fi="Lue koko kirja" en="Read the full book" /></h2>
            <p class="i18n" lang="fi">Tämä tiivistelmä on johdatus teokseen. Kirjan varsinainen arvo on sen perusteluissa, esimerkeissä ja kirjoittajan omassa äänessä, joita tiivistelmä ei voi korvata. Suosittelemme lämpimästi lukemaan koko kirjan.</p>
            <p class="i18n" lang="en">This summary is an introduction. The real value of the book lies in its arguments, examples and the author's own voice, which no summary can replace. We warmly recommend reading the whole book.</p>
            <dl class="read-full-meta">
              <div><dt><T fi="Kirjoittaja" en="Author" /></dt><dd>{d.author}</dd></div>
              <div><dt><T fi="Alkuteos" en="Original title" /></dt><dd lang="en">{d.title} ({d.year})</dd></div>
              {d.title_fi && <div><dt><T fi="Suomennos" en="Finnish translation" /></dt><dd lang="fi">{d.title_fi}</dd></div>}
            </dl>
            <ul class="read-full-links">
              <li><a href={finnaUrl} rel="noopener"><T fi="Etsi kirjastoista (Finna)" en="Find in Finnish libraries (Finna)" /></a></li>
              {d.olid && <li><a href={`https://openlibrary.org/books/${d.olid}`} rel="noopener">Open Library</a></li>}
            </ul>
          </div>
        </section>

        <section id="lahteet" class="sources" data-pagefind-ignore>
          <h2><T fi="Lähteet" en="Sources" /></h2>
          <ul>
            {d.lahteet.map((s) => <li><a href={s.url} rel="noopener">{s.nimi}</a></li>)}
            {d.olid && (
              <li><a href={`https://openlibrary.org/books/${d.olid}`} rel="noopener"><T fi="Teos Open Libraryssä" en="This book on Open Library" /></a></li>
            )}
          </ul>
        </section>
      </div>
    </div>
    <p class="back-nav back-nav-end" data-pagefind-ignore>
      <a class="back-link" href="/" data-back><T fi="← Takaisin kokoelmaan" en="← Back to the collection" /></a>
    </p>
  </article>

  <script is:inline>
    (function () {
      var bar = document.querySelector('[data-progress]');
      var links = document.querySelectorAll('.toc a, .toc-mobile a');
      var sections = document.querySelectorAll('.book-text > section[id]');
      var activeId;
      var pending = false;

      // Mark the section being read in both tables of contents, from the scroll position itself, so
      // it is right after any scroll or jump in either direction: the last section whose top has
      // passed a quarter of the screen; none above the first section; the last one at the very bottom.
      function markActive(el, max) {
        var line = window.innerHeight * 0.25;
        var id = null;
        for (var i = 0; i < sections.length; i++) {
          if (sections[i].getBoundingClientRect().top <= line) id = sections[i].id;
          else break;
        }
        if (max > 0 && el.scrollTop >= max - 2 && sections.length) id = sections[sections.length - 1].id;
        if (id === activeId) return;
        activeId = id;
        links.forEach(function (a) {
          if (id && a.getAttribute('href') === '#' + id) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      }

      function update() {
        pending = false;
        var el = document.documentElement;
        var max = el.scrollHeight - el.clientHeight;
        bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, el.scrollTop / max) : 0) + ')';
        markActive(el, max);
      }
      function request() {
        if (!pending) {
          pending = true;
          requestAnimationFrame(update);
        }
      }
      addEventListener('scroll', request, { passive: true });
      addEventListener('resize', request);
      update();
      // Covers and fonts can move sections after the first paint, and the fade-in slides each
      // section 10 px into place after it has been scrolled to.
      addEventListener('load', request);

      // Smart back: when the previous page was this site's home page, go back in history instead,
      // so the home page returns with its filters, search and scroll position. Otherwise (or
      // without JavaScript) the links simply open the home page.
      var cameFromHome = false;
      try {
        var ref = document.referrer ? new URL(document.referrer) : null;
        cameFromHome = !!ref && ref.origin === location.origin && ref.pathname === '/' && history.length > 1;
      } catch (e) {}
      if (cameFromHome) {
        document.querySelectorAll('[data-back]').forEach(function (a) {
          a.addEventListener('click', function (e) {
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
            e.preventDefault();
            history.back();
          });
        });
      }
      document.addEventListener('transitionend', function (e) {
        if (e.propertyName === 'transform' && e.target.matches && e.target.matches('.book-text > section')) request();
      });
    })();
  </script>
</Base>
