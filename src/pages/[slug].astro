---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import Cover from '../components/Cover.astro';
import CoverGlow from '../components/CoverGlow.astro';
import T from '../components/T.astro';
import { tags } from '../data/tags';
import { coverSrc, md, mdInline, readingMinutes, type Book } from '../lib/book';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book, related: books.filter((b) => book.data.liittyvat.includes(b.id)) },
  }));
}

const { book, related } = Astro.props as { book: CollectionEntry<'books'>; related: Book[] };
const d = book.data;
const languages = [
  { code: 'fi', content: d.fi },
  { code: 'en', content: d.en },
] as const;

const hasKasitteet = d.fi.kasitteet.length > 0 || d.en.kasitteet.length > 0;
const hasSuositukset = d.fi.suositukset.length > 0 || d.en.suositukset.length > 0;
const hasHuomio = d.fi.huomio.length > 0 || d.en.huomio.length > 0;
const hasOmaHuomio = d.oma_huomio.trim().length > 0;

const toc = [
  { id: 'yleiskuva', fi: 'Yleiskuva', en: 'Overview', show: true },
  { id: 'viestit', fi: 'Keskeiset viestit', en: 'Key messages', show: true },
  { id: 'kasitteet', fi: 'Käsitteet', en: 'Concepts', show: hasKasitteet },
  { id: 'kirjoittaja', fi: 'Kirjoittaja', en: 'The author', show: true },
  { id: 'suositukset', fi: 'Kirjan suositukset', en: "The book's recommendations", show: hasSuositukset },
  { id: 'huomio', fi: 'Huomio', en: 'Note', show: hasHuomio },
  { id: 'oma-huomio', fi: 'Oma huomio', en: 'Personal note', show: hasOmaHuomio },
  { id: 'liittyvat', fi: 'Liittyvät kirjat', en: 'Related books', show: related.length > 0 },
  { id: 'lue-koko-kirja', fi: 'Lue koko kirja', en: 'Read the full book', show: true },
  { id: 'lahteet', fi: 'Lähteet', en: 'Sources', show: true },
].filter((item) => item.show);

// Library search on Finna by title and author. Punctuation is dropped from the query; the
// search form was checked to return the right book first for every book in the library.
const finnaQuery = `${(d.title_fi ?? d.title).replace(/[:,]/g, '')} ${d.author}`;
const finnaUrl = `https://www.finna.fi/Search/Results?lookfor=${encodeURIComponent(finnaQuery)}&type=AllFields`;

const varmuusEn = { korkea: 'high', kohtalainen: 'moderate', matala: 'low' }[d.varmuus];
const titleFi = `${d.title_fi ?? d.title} | RayDar Library`;
const titleEn = `${d.title} | RayDar Library`;
---
<Base titleFi={titleFi} titleEn={titleEn} description={d.fi.ydin} ogImage={coverSrc(d, 'L') ?? undefined} book>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <article class="book" data-pagefind-body data-hue={tags[d.tags[0]].hue}>
    <!-- The small M cover keeps the glow from becoming the largest contentful paint: the L cover
         loads through two redirects, and a blurred glow needs no detail. -->
    <div class="book-glow-wrap" data-anim aria-hidden="true"><CoverGlow book={d} size="M" class="book-glow" /></div>
    <!-- Back to the collection: a plain link to the home page; the script below turns it into
         history.back() when the reader came from the home page, so filters and scroll position return. -->
    <p class="back-nav back-nav-top" data-pagefind-ignore>
      <a class="back-link" href="/" data-back><T fi="← Kokoelma" en="← Collection" /></a>
    </p>
    <header class="book-head">
      <div class="book-cover"><Cover book={d} size="L" eager /></div>
      <div class="book-info">
        <h1 class="book-title">
          {d.title_fi ? <T fi={d.title_fi} en={d.title} /> : d.title}
        </h1>
        {d.title_fi && <p class="book-original i18n" lang="fi">Alkuteos: {d.title}</p>}
        <p class="book-author">{d.author} · {d.year}</p>
        <ul class="tag-list" data-pagefind-ignore>
          {d.tags.map((t) => <li class="tag" data-hue={tags[t].hue}><T fi={tags[t].fi} en={tags[t].en} /></li>)}
        </ul>
        <p class="book-marks" data-pagefind-ignore>
          <T fi={`Noin ${readingMinutes(d.fi)} min lukuaika`} en={`About ${readingMinutes(d.en)} min read`} />
          <span aria-hidden="true"> · </span>
          <T fi={`Varmuus: ${d.varmuus}`} en={`Confidence: ${varmuusEn}`} />
        </p>
      </div>
    </header>

    <div class="ydin">
      <div class="i18n" lang="fi" set:html={md(d.fi.ydin)} />
      <div class="i18n" lang="en" set:html={md(d.en.ydin)} />
    </div>
    <p class="read-full-hint" data-pagefind-ignore>
      <a href="#lue-koko-kirja"><T fi="Johdatus teokseen, ei korvaa kirjaa. Lue koko kirja ↓" en="An introduction, not a replacement. Read the full book ↓" /></a>
    </p>

    <!-- Listen: a player card that reads the summary aloud with the browser's own speech synthesis.
         Hidden until the script below finds the Web Speech API; without it (or without JavaScript)
         nothing is shown. -->
    <div class="listen" data-listen data-pagefind-ignore hidden
      data-title-fi={d.title_fi ?? d.title} data-title-en={d.title} data-author={d.author}>
      <div class="player" data-listen-controls hidden>
        <button type="button" class="player-play" data-listen-play aria-pressed="false"
          data-label-fi="Kuuntele tiivistelmä" data-label-en="Listen to the summary" aria-label="Kuuntele tiivistelmä">
          <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 2.8v10.4l8.2-5.2z" fill="currentColor" /></svg>
          <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor" /></svg>
        </button>
        <span class="player-wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <div class="player-meta">
          <p class="player-title"><T fi="Kuuntele tiivistelmä" en="Listen to the summary" /></p>
          <p class="player-sub">
            <span class="player-time" data-listen-time><span class="i18n" lang="fi"></span><span class="i18n" lang="en"></span></span>
            <span class="player-now" data-listen-now></span>
          </p>
        </div>
        <button type="button" class="player-stop" data-listen-stop hidden
          data-label-fi="Pysäytä luenta" data-label-en="Stop reading" aria-label="Pysäytä luenta">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4h8v8H4z" fill="currentColor" /></svg>
        </button>
        <div class="player-rate" role="group" data-label-fi="Puhenopeus" data-label-en="Speech rate" aria-label="Puhenopeus">
          <button type="button" data-rate="0.9" aria-pressed="false"
            data-label-fi="Nopeus 0,9" data-label-en="Rate 0.9" aria-label="Nopeus 0,9"><T fi="0,9×" en="0.9×" /></button>
          <button type="button" data-rate="1" aria-pressed="true"
            data-label-fi="Nopeus 1" data-label-en="Rate 1" aria-label="Nopeus 1">1×</button>
          <button type="button" data-rate="1.2" aria-pressed="false"
            data-label-fi="Nopeus 1,2" data-label-en="Rate 1.2" aria-label="Nopeus 1,2"><T fi="1,2×" en="1.2×" /></button>
        </div>
        <span class="player-progress" aria-hidden="true"><span data-listen-bar></span></span>
      </div>
      <p class="player player-note" data-listen-note hidden>
        <T fi="Laitteessasi ei ole suomenkielistä puheääntä." en="Your device has no English speech voice." />
      </p>
      <p class="visually-hidden" aria-live="polite" data-listen-live></p>
    </div>

    <details class="toc-mobile" data-pagefind-ignore>
      <summary><T fi="Sisällys" en="Contents" /></summary>
      <ul>{toc.map((item) => <li><a href={`#${item.id}`}><T fi={item.fi} en={item.en} /></a></li>)}</ul>
    </details>

    <div class="book-layout">
      <nav class="toc" data-pagefind-ignore data-label-fi="Sisällys" data-label-en="Contents" aria-label="Sisällys">
        <p class="toc-title"><T fi="Sisällys" en="Contents" /></p>
        <ul>{toc.map((item) => <li><a href={`#${item.id}`}><T fi={item.fi} en={item.en} /></a></li>)}</ul>
      </nav>

      <div class="book-text">
        <section id="yleiskuva">
          <h2><T fi="Yleiskuva" en="Overview" /></h2>
          {languages.map(({ code, content }) => <div class="prose i18n" lang={code} set:html={md(content.yleiskuva)} />)}
        </section>

        <section id="viestit">
          <h2><T fi="Keskeiset viestit" en="Key messages" /></h2>
          {languages.map(({ code, content }) => (
            <ol class="ideas i18n" lang={code}>
              {content.ideat.map((idea, i) => (
                <li class="idea">
                  <span class="idea-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3 set:html={mdInline(idea.otsikko)} />
                  <div class="prose" set:html={md(idea.selitys)} />
                </li>
              ))}
            </ol>
          ))}
        </section>

        {hasKasitteet && (
          <section id="kasitteet">
            <h2><T fi="Käsitteet" en="Concepts" /></h2>
            {languages.map(({ code, content }) => (
              <dl class="concepts i18n" lang={code}>
                {content.kasitteet.map((k) => (
                  <div>
                    <dt>{k.termi}</dt>
                    <dd set:html={md(k.selitys)} />
                  </div>
                ))}
              </dl>
            ))}
          </section>
        )}

        <section id="kirjoittaja">
          <h2><T fi="Kirjoittaja" en="The author" /></h2>
          {languages.map(({ code, content }) => <div class="prose i18n" lang={code} set:html={md(content.kirjoittaja)} />)}
        </section>

        {hasSuositukset && (
          <section id="suositukset">
            <h2><T fi="Kirjan suositukset" en="The book's recommendations" /></h2>
            {languages.map(({ code, content }) => (
              <ul class="prose recommendations i18n" lang={code}>
                {content.suositukset.map((s) => <li set:html={mdInline(s)} />)}
              </ul>
            ))}
          </section>
        )}

        {hasHuomio && (
          <section id="huomio" class="note">
            <h2><T fi="Huomio" en="Note" /></h2>
            {languages.map(({ code, content }) => (
              <div class="i18n" lang={code}>
                {content.huomio.map((h) => <div set:html={md(h)} />)}
              </div>
            ))}
          </section>
        )}

        {hasOmaHuomio && (
          <section id="oma-huomio" class="personal-note">
            <h2><T fi="Oma huomio" en="Personal note" /></h2>
            <div class="prose" set:html={md(d.oma_huomio)} />
          </section>
        )}

        {related.length > 0 && (
          <section id="liittyvat" data-pagefind-ignore>
            <h2><T fi="Liittyvät kirjat" en="Related books" /></h2>
            <div class="related">{related.map((b) => <BookCard book={b} />)}</div>
          </section>
        )}

        <section id="lue-koko-kirja" class="read-full" data-pagefind-ignore>
          <div class="read-full-cover"><Cover book={d} size="M" /></div>
          <div class="read-full-body">
            <h2><T fi="Lue koko kirja" en="Read the full book" /></h2>
            <p class="i18n" lang="fi">Tämä tiivistelmä on johdatus teokseen. Kirjan varsinainen arvo on sen perusteluissa, esimerkeissä ja kirjoittajan omassa äänessä, joita tiivistelmä ei voi korvata. Suosittelemme lämpimästi lukemaan koko kirjan.</p>
            <p class="i18n" lang="en">This summary is an introduction. The real value of the book lies in its arguments, examples and the author's own voice, which no summary can replace. We warmly recommend reading the whole book.</p>
            <dl class="read-full-meta">
              <div><dt><T fi="Kirjoittaja" en="Author" /></dt><dd>{d.author}</dd></div>
              <div><dt><T fi="Alkuteos" en="Original title" /></dt><dd lang="en">{d.title} ({d.year})</dd></div>
              {d.title_fi && <div><dt><T fi="Suomennos" en="Finnish translation" /></dt><dd lang="fi">{d.title_fi}</dd></div>}
            </dl>
            <ul class="read-full-links">
              <li><a href={finnaUrl} rel="noopener"><T fi="Etsi kirjastoista (Finna)" en="Find in Finnish libraries (Finna)" /></a></li>
              {d.olid && <li><a href={`https://openlibrary.org/books/${d.olid}`} rel="noopener">Open Library</a></li>}
            </ul>
          </div>
        </section>

        <section id="lahteet" class="sources" data-pagefind-ignore>
          <h2><T fi="Lähteet" en="Sources" /></h2>
          <ul>
            {d.lahteet.map((s) => <li><a href={s.url} rel="noopener">{s.nimi}</a></li>)}
            {d.olid && (
              <li><a href={`https://openlibrary.org/books/${d.olid}`} rel="noopener"><T fi="Teos Open Libraryssä" en="This book on Open Library" /></a></li>
            )}
          </ul>
        </section>
      </div>
    </div>
    <p class="back-nav back-nav-end" data-pagefind-ignore>
      <a class="back-link" href="/" data-back><T fi="← Takaisin kokoelmaan" en="← Back to the collection" /></a>
    </p>
  </article>

  <!-- Mini player: appears at the bottom of the screen while reading once the player card has
       scrolled out of view. Outside the article, so no stacking context keeps it under the text. -->
  <div class="mini-player" data-listen-mini data-pagefind-ignore hidden role="group"
    data-label-fi="Kuuntelu" data-label-en="Listening" aria-label="Kuuntelu">
    <button type="button" class="player-play mini-play" data-listen-play aria-pressed="false"
      data-label-fi="Kuuntele tiivistelmä" data-label-en="Listen to the summary" aria-label="Kuuntele tiivistelmä">
      <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 2.8v10.4l8.2-5.2z" fill="currentColor" /></svg>
      <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor" /></svg>
    </button>
    <span class="mini-now" data-listen-now></span>
    <button type="button" class="player-stop" data-listen-stop
      data-label-fi="Pysäytä luenta" data-label-en="Stop reading" aria-label="Pysäytä luenta">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4h8v8H4z" fill="currentColor" /></svg>
    </button>
  </div>

  <script is:inline>
    (function () {
      var bar = document.querySelector('[data-progress]');
      var links = document.querySelectorAll('.toc a, .toc-mobile a');
      var sections = document.querySelectorAll('.book-text > section[id]');
      var activeId;
      var pending = false;

      // Mark the section being read in both tables of contents, from the scroll position itself, so
      // it is right after any scroll or jump in either direction: the last section whose top has
      // passed a quarter of the screen; none above the first section; the last one at the very bottom.
      function markActive(el, max) {
        var line = window.innerHeight * 0.25;
        var id = null;
        for (var i = 0; i < sections.length; i++) {
          if (sections[i].getBoundingClientRect().top <= line) id = sections[i].id;
          else break;
        }
        if (max > 0 && el.scrollTop >= max - 2 && sections.length) id = sections[sections.length - 1].id;
        if (id === activeId) return;
        activeId = id;
        links.forEach(function (a) {
          if (id && a.getAttribute('href') === '#' + id) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      }

      function update() {
        pending = false;
        var el = document.documentElement;
        var max = el.scrollHeight - el.clientHeight;
        bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, el.scrollTop / max) : 0) + ')';
        markActive(el, max);
      }
      function request() {
        if (!pending) {
          pending = true;
          requestAnimationFrame(update);
        }
      }
      addEventListener('scroll', request, { passive: true });
      addEventListener('resize', request);
      update();
      // Covers and fonts can move sections after the first paint, and the fade-in slides each
      // section 10 px into place after it has been scrolled to.
      addEventListener('load', request);

      // Smart back: when the previous page was this site's home page, go back in history instead,
      // so the home page returns with its filters, search and scroll position. Otherwise (or
      // without JavaScript) the links simply open the home page.
      var cameFromHome = false;
      try {
        var ref = document.referrer ? new URL(document.referrer) : null;
        cameFromHome = !!ref && ref.origin === location.origin && ref.pathname === '/' && history.length > 1;
      } catch (e) {}
      if (cameFromHome) {
        document.querySelectorAll('[data-back]').forEach(function (a) {
          a.addEventListener('click', function (e) {
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
            e.preventDefault();
            history.back();
          });
        });
      }
      document.addEventListener('transitionend', function (e) {
        if (e.propertyName === 'transform' && e.target.matches && e.target.matches('.book-text > section')) request();
      });
    })();
  </script>

  <script is:inline>
    // Listen: reads the summary aloud in the page language with the browser's speech synthesis.
    (function () {
      var box = document.querySelector('[data-listen]');
      var synth = window.speechSynthesis;
      if (!box || !synth || typeof window.SpeechSynthesisUtterance !== 'function') return;

      var root = document.documentElement;
      var card = box.querySelector('[data-listen-controls]');
      var note = box.querySelector('[data-listen-note]');
      var mini = document.querySelector('[data-listen-mini]');
      var players = [box, mini];
      var playBtns = document.querySelectorAll('[data-listen-play]');
      var stopBtns = document.querySelectorAll('[data-listen-stop]');
      var nowEls = document.querySelectorAll('[data-listen-now]');
      var timeEl = box.querySelector('[data-listen-time]');
      var bar = box.querySelector('[data-listen-bar]');
      var live = box.querySelector('[data-listen-live]');
      var rateBtns = box.querySelectorAll('[data-rate]');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Sections read aloud, in page order; everything else (contents, sources, links) is skipped.
      // A section's parts (for "Key messages · 3/9") are its ideas, concepts or items; elsewhere its paragraphs.
      var SECTIONS = ['yleiskuva', 'viestit', 'kasitteet', 'kirjoittaja', 'suositukset', 'huomio'];
      var PARTS = { viestit: '.idea', kasitteet: '.concepts > div', suositukset: 'li' };
      var CORE = { fi: 'Ydinsanoma', en: 'Core message' };
      // Chrome cuts long utterances short, so text is spoken a sentence group at a time.
      var MAX_CHARS = 220;
      // Listening time estimate: words at about 150 per minute, times the chosen rate.
      var WORDS_PER_MINUTE = 150;

      var state = 'idle'; // idle | playing | paused
      var queue = [];
      var totalChars = 0;
      var pos = 0;
      var gen = 0; // bumped on every pause/stop/restart, so events from cancelled utterances are ignored
      var rate = 1;
      var voice = null;
      var current = null; // keeps the playing utterance referenced (Chrome may drop its events otherwise)
      var marked = null;
      var lastEl = null;
      var lastSection = null;
      var cardInView = true;
      var voicesTimedOut = false;

      var lang = function () { return root.dataset.lang === 'en' ? 'en' : 'fi'; };

      // Best voice for the language: the right language first (fi-FI; en-US or en-GB), then the
      // higher-quality voices whose names say Natural, Online or Neural.
      function pickVoice(l) {
        var best = null;
        var bestScore = -1;
        synth.getVoices().forEach(function (v) {
          var vl = (v.lang || '').replace('_', '-').toLowerCase();
          if (vl.slice(0, 2) !== l) return;
          var score = 0;
          if (l === 'fi' ? vl === 'fi-fi' : vl === 'en-us' || vl === 'en-gb') score += 2;
          if (/natural|online|neural/i.test(v.name)) score += 4;
          if (score > bestScore) { best = v; bestScore = score; }
        });
        return best;
      }

      var text = function (el) { return (el.textContent || '').replace(/\s+/g, ' ').trim(); };
      var sentence = function (t) { return /[.!?…:]$/.test(t) ? t : t + '.'; };

      function split(t) {
        var parts = t.match(/[^.!?…]+(?:[.!?…]+["”’)]*|$)\s*/g) || [t];
        var out = [];
        var buf = '';
        parts.forEach(function (p) {
          while (p.length > MAX_CHARS) {
            var cut = p.lastIndexOf(', ', MAX_CHARS);
            if (cut < MAX_CHARS / 2) cut = p.lastIndexOf(' ', MAX_CHARS);
            if (cut < 1) cut = MAX_CHARS;
            if (buf) { out.push(buf); buf = ''; }
            out.push(p.slice(0, cut + 1));
            p = p.slice(cut + 1);
          }
          if ((buf + p).length > MAX_CHARS && buf) { out.push(buf); buf = ''; }
          buf += p;
        });
        if (buf.trim()) out.push(buf);
        return out.map(function (s) { return s.trim(); }).filter(Boolean);
      }

      // The reading queue for a language: sentence groups with their element, section and part.
      function build(l) {
        var q = [];
        var add = function (el, t, section, part, parts) {
          if (!t) return;
          split(t).forEach(function (s) { q.push({ el: el, text: s, section: section, part: part, parts: parts }); });
        };
        add(document.querySelector('.book-title'), sentence(box.dataset['title' + (l === 'en' ? 'En' : 'Fi')]) + ' ' + sentence(box.dataset.author), CORE[l], 0, 0);
        var ydin = document.querySelector('.ydin .i18n[lang="' + l + '"]');
        if (ydin) add(document.querySelector('.ydin'), text(ydin), CORE[l], 0, 0);
        SECTIONS.forEach(function (id) {
          var section = document.getElementById(id);
          if (!section) return;
          var h2 = section.querySelector('h2 .i18n[lang="' + l + '"]');
          var name = h2 ? text(h2) : id;
          if (h2) add(section.querySelector('h2'), sentence(name), name, 0, 0);
          section.querySelectorAll('.i18n[lang="' + l + '"]').forEach(function (container) {
            if (container.closest('h2')) return;
            var blocks = Array.prototype.filter.call(container.querySelectorAll('h3, p, dt, li'), function (el) {
              return !el.querySelector('h3, p, dt, li');
            });
            var units = PARTS[id] ? Array.prototype.slice.call(container.querySelectorAll(PARTS[id])) : blocks;
            blocks.forEach(function (el) {
              var t = text(el);
              if (el.tagName === 'H3') {
                var num = el.parentNode.querySelector('.idea-num');
                t = (num ? parseInt(num.textContent, 10) + '. ' : '') + sentence(t);
              } else if (el.tagName === 'DT') {
                t = sentence(t);
              }
              var unit = PARTS[id] ? el.closest(PARTS[id]) : el;
              add(el, t, name, units.indexOf(unit) + 1, units.length);
            });
          });
        });
        return q;
      }

      function updateTime() {
        ['fi', 'en'].forEach(function (l) {
          var words = build(l).reduce(function (n, item) { return n + item.text.split(/\s+/).length; }, 0);
          var min = Math.max(1, Math.round(words / (WORDS_PER_MINUTE * rate)));
          timeEl.querySelector('[lang="' + l + '"]').textContent = (l === 'fi' ? 'noin ' : 'about ') + min + ' min';
        });
      }

      function refresh() {
        voice = pickVoice(lang());
        var known = synth.getVoices().length > 0 || voicesTimedOut;
        box.hidden = !voice && !known;
        card.hidden = !voice;
        note.hidden = !!voice || !known;
      }

      function inView(el) {
        var r = el.getBoundingClientRect();
        return r.bottom > 0 && r.top < innerHeight;
      }

      // Highlight only on the reading panel; scroll only when the reader is following along (the
      // previous block was on screen) and the new block is leaving or below the screen (or under
      // the mini player).
      function mark(el) {
        var following = !lastEl || inView(lastEl);
        if (marked && marked !== el) marked.classList.remove('is-speaking');
        marked = null;
        if (el && el.closest('.book-text')) {
          el.classList.add('is-speaking');
          marked = el;
        }
        if (el && el !== lastEl && following) {
          var r = el.getBoundingClientRect();
          var bottomEdge = innerHeight - (mini.hidden ? 16 : mini.offsetHeight + 24);
          if (r.top < 16 || r.bottom > bottomEdge) {
            el.scrollIntoView({ block: r.height > innerHeight * 0.6 ? 'start' : 'center', behavior: reduce ? 'auto' : 'smooth' });
          }
        }
        lastEl = el;
      }

      function showNow(item) {
        var label = item.section + (item.part ? ' · ' + item.part + '/' + item.parts : '');
        nowEls.forEach(function (el) { el.textContent = label; });
        // The live region announces only a new section, not every paragraph.
        if (item.section !== lastSection) {
          lastSection = item.section;
          live.textContent = item.section;
        }
        var done = 0;
        for (var i = 0; i < pos; i++) done += queue[i].text.length;
        bar.style.transform = 'scaleX(' + (totalChars ? done / totalChars : 0) + ')';
      }

      function speakNext() {
        if (state !== 'playing') return;
        if (pos >= queue.length) { stop(); return; }
        var item = queue[pos];
        mark(item.el);
        showNow(item);
        var u = new SpeechSynthesisUtterance(item.text);
        var my = gen;
        u.voice = voice;
        u.lang = voice.lang;
        u.rate = rate;
        u.onend = function () {
          if (my !== gen) return;
          pos++;
          speakNext();
        };
        u.onerror = function (e) {
          if (my !== gen || e.error === 'interrupted' || e.error === 'canceled') return;
          pos++;
          speakNext();
        };
        current = u;
        synth.speak(u);
      }

      function render() {
        var active = state !== 'idle';
        playBtns.forEach(function (b) { b.setAttribute('aria-pressed', String(state === 'playing')); });
        players.forEach(function (p) {
          p.classList.toggle('is-playing', state === 'playing');
          p.classList.toggle('is-active', active);
        });
        box.querySelector('[data-listen-stop]').hidden = !active;
        var showMini = active && !cardInView;
        // Move focus back to the card before hiding the mini player, so keyboard users stay in place.
        if (!showMini && mini.contains(document.activeElement)) box.querySelector('[data-listen-play]').focus({ preventScroll: true });
        mini.hidden = !showMini;
        root.classList.toggle('listen-mini-on', showMini);
      }

      // Pausing cancels and later repeats the current sentence group: speechSynthesis.pause() is
      // unreliable across browsers and online voices.
      function start() {
        if (!voice) return;
        if (state === 'idle') {
          queue = build(lang());
          totalChars = queue.reduce(function (n, item) { return n + item.text.length; }, 0);
          pos = 0;
          lastEl = null;
          lastSection = null;
        }
        state = 'playing';
        gen++;
        synth.cancel();
        render();
        var my = gen;
        setTimeout(function () { if (my === gen) speakNext(); }, 60);
      }
      function pause() {
        state = 'paused';
        gen++;
        synth.cancel();
        render();
      }
      function stop() {
        var wasActive = state !== 'idle';
        state = 'idle';
        gen++;
        current = null;
        if (wasActive) synth.cancel();
        pos = 0;
        lastEl = null;
        lastSection = null;
        if (marked) marked.classList.remove('is-speaking');
        marked = null;
        bar.style.transform = 'scaleX(0)';
        nowEls.forEach(function (el) { el.textContent = ''; });
        render();
      }

      playBtns.forEach(function (b) {
        b.addEventListener('click', function () { state === 'playing' ? pause() : start(); });
      });
      stopBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          var fromMini = mini.contains(b);
          stop();
          box.querySelector('[data-listen-play]').focus({ preventScroll: fromMini });
        });
      });
      rateBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          rate = Number(b.dataset.rate);
          rateBtns.forEach(function (o) { o.setAttribute('aria-pressed', String(o === b)); });
          updateTime();
          if (state === 'playing') start(); // restart the current sentence group at the new rate
        });
      });

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          cardInView = entries[entries.length - 1].isIntersecting;
          render();
        }).observe(card);
      }

      // A language change or leaving the page stops the reading.
      new MutationObserver(function (records) {
        if (records.every(function (r) { return r.oldValue === root.dataset.lang; })) return;
        stop();
        refresh();
      }).observe(root, { attributes: true, attributeFilter: ['data-lang'], attributeOldValue: true });
      addEventListener('pagehide', stop);

      synth.cancel();
      updateTime();
      refresh();
      if (synth.addEventListener) synth.addEventListener('voiceschanged', refresh);
      else synth.onvoiceschanged = refresh;
      // Some browsers never fire voiceschanged when there are no voices: decide after a moment.
      setTimeout(function () { voicesTimedOut = true; refresh(); }, 1500);
    })();
  </script>
</Base>
