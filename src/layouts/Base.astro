---
import '../styles/tokens.css';
import '../styles/global.css';
import T from '../components/T.astro';
import { site } from '../site.config';

interface Props {
  titleFi: string;
  titleEn: string;
  description?: string;
  home?: boolean;
  book?: boolean;
  ogImage?: string;
}
const { titleFi, titleEn, description, home = false, book = false, ogImage } = Astro.props;
// Four light pools in one fixed layer, so every screenful shows brass and moonlight
// whatever the page length. Each pool's wrapper takes the scroll offset (script), the pool itself drifts (CSS).
const pools = [
  { kind: 'brass', pos: 'p1' },
  { kind: 'moon', pos: 'p2' },
  { kind: 'moon', pos: 'p3' },
  { kind: 'brass', pos: 'p4' },
];
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="fi" data-lang="fi" data-panel={site.panel} data-title-fi={titleFi} data-title-en={titleEn}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleFi}</title>
    <meta name="theme-color" content="#0d2040" />
    {!site.indexable && <meta name="robots" content="noindex" />}
    {site.indexable && description && <meta name="description" content={description} />}
    {site.indexable && <link rel="canonical" href={canonical} />}
    {site.indexable && <meta property="og:type" content="website" />}
    {site.indexable && <meta property="og:title" content={titleFi} />}
    {site.indexable && <meta property="og:url" content={canonical} />}
    {site.indexable && description && <meta property="og:description" content={description} />}
    {site.indexable && ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function () {
        var lang = 'fi';
        try {
          var saved = localStorage.getItem('raydar-library-lang');
          if (saved === 'fi' || saved === 'en') lang = saved;
        } catch (e) {}
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
        // Reading-panel variant comparison: ?panel=a or ?panel=b overrides site.panel.
        try {
          var panel = new URLSearchParams(location.search).get('panel');
          if (panel === 'a' || panel === 'b') document.documentElement.dataset.panel = panel;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={[{ 'is-home': home, 'is-book': book }]}>
    <div class="ambience" aria-hidden="true">
      <div class="amb-edges"></div>
      <div class="amb-figure left" data-anim></div>
      <div class="amb-figure right" data-anim></div>
      <div class="amb-pools">
        {pools.map((p) => <div class={`amb-pool-track ${p.pos}`}><div class={`amb-pool ${p.kind}`}></div></div>)}
      </div>
      <div class="amb-stars"></div>
      <div class="amb-twinkle t1"></div>
      <div class="amb-twinkle t2"></div>
      <div class="amb-grain"></div>
      <div class="amb-lantern"></div>
    </div>
    <div class="laser" aria-hidden="true"></div>
    <div class="laser-glow" aria-hidden="true"></div>
    <a class="skip-link" href="#content"><T fi="Siirry sisältöön" en="Skip to content" /></a>
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="RayDar Library">
        <span class="wordmark-ray">Ray<span>Dar</span></span>
        <span class="wordmark-dot" aria-hidden="true"></span>
        <span class="wordmark-sub">Library</span>
      </a>
      <div class="lang-switch" role="group" aria-label="Kieli / Language">
        <button type="button" data-lang-btn="fi" lang="fi" aria-label="Suomi">FI</button>
        <button type="button" data-lang-btn="en" lang="en" aria-label="English">EN</button>
      </div>
    </header>
    <slot name="hero" />
    <main id="content"><slot /></main>
    <footer class="footer">
      <div class="footer-inner">
        <p class="footer-note"><T fi="Tiivistelmät on tuotettu tekoälyn avulla ja voivat sisältää virheitä." en="Summaries are AI-generated and may contain errors." /></p>
        <p class="footer-links">
          <a href="https://raydar.fi/">raydar.fi</a>
          <a href="https://openlibrary.org/" rel="noopener">Covers: Open Library</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function apply(lang) {
          root.dataset.lang = lang;
          root.lang = lang;
          var suffix = lang === 'en' ? 'En' : 'Fi';
          document.title = root.dataset['title' + suffix];
          document.querySelectorAll('[data-alt-fi]').forEach(function (el) {
            el.alt = el.dataset['alt' + suffix];
          });
          document.querySelectorAll('[data-placeholder-fi]').forEach(function (el) {
            el.placeholder = el.dataset['placeholder' + suffix];
          });
          document.querySelectorAll('[data-text-fi]').forEach(function (el) {
            el.textContent = el.dataset['text' + suffix];
          });
          document.querySelectorAll('[data-label-fi]').forEach(function (el) {
            el.setAttribute('aria-label', el.dataset['label' + suffix]);
          });
          document.querySelectorAll('[data-lang-btn]').forEach(function (el) {
            el.setAttribute('aria-pressed', String(el.dataset.langBtn === lang));
          });
        }
        document.querySelectorAll('[data-lang-btn]').forEach(function (el) {
          el.addEventListener('click', function () {
            var lang = el.dataset.langBtn;
            apply(lang);
            try {
              localStorage.setItem('raydar-library-lang', lang);
            } catch (e) {}
          });
        });
        apply(root.dataset.lang);

        // Short fade-in for cards and sections as they scroll into view. Skipped entirely
        // when the reader prefers reduced motion, so nothing is ever hidden for them.
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && 'IntersectionObserver' in window) {
          root.classList.add('reveal-ready');
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -6% 0px' });
          document.querySelectorAll('.card, .book-text > section').forEach(function (el) { io.observe(el); });
        }

        // Edge figures fade out over the home hero, so the hero image has no competition. This
        // tracks where the hero is (not motion), so it also runs with reduced motion.
        // Only where the figures are shown (same breakpoint as the CSS), so narrow screens skip the layout reads.
        var figures = window.matchMedia('(min-width: 1400px)').matches ? document.querySelectorAll('.amb-figure') : [];
        var heroEl = document.querySelector('.hero');
        if (figures.length && heroEl) {
          var cutPending = false;
          var cut = function () {
            cutPending = false;
            var heroBottom = heroEl.getBoundingClientRect().bottom;
            figures.forEach(function (f) {
              var c = Math.max(0, heroBottom - f.getBoundingClientRect().top);
              f.style.setProperty('--hero-cut', c.toFixed(0) + 'px');
            });
          };
          addEventListener('scroll', function () { if (!cutPending) { cutPending = true; requestAnimationFrame(cut); } }, { passive: true });
          addEventListener('resize', cut);
          cut();
        }

        // Slow background motion. Off with reduced motion or --motion: 0. Animations only run
        // while their element is near the viewport (class in-view), so nothing works off screen.
        var motion = parseFloat(getComputedStyle(root).getPropertyValue('--motion')) || 0;
        if (reduce || motion <= 0 || !('IntersectionObserver' in window)) return;
        root.classList.add('motion-on');
        var aio = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) { entry.target.classList.toggle('in-view', entry.isIntersecting); });
        }, { rootMargin: '200px 0px' });
        document.querySelectorAll('[data-anim]').forEach(function (el) { aio.observe(el); });

        // Cursor lantern: a soft warm light that follows a mouse pointer with a gentle lag,
        // in the background layer only. Home page only, and only for fine pointers.
        var lantern = document.querySelector('.amb-lantern');
        if (lantern && document.body.classList.contains('is-home') && window.matchMedia('(pointer: fine)').matches) {
          var tx = 0, ty = 0, x = 0, y = 0, frame = 0, shown = false;
          var step = function () {
            x += (tx - x) * 0.07;
            y += (ty - y) * 0.07;
            lantern.style.transform = 'translate3d(' + (x - 280) + 'px,' + (y - 280) + 'px,0)';
            frame = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
          };
          addEventListener('pointermove', function (e) {
            if (e.pointerType !== 'mouse') return;
            tx = e.clientX;
            ty = e.clientY;
            if (!shown) { x = tx; y = ty; shown = true; lantern.classList.add('on'); }
            if (!frame) frame = requestAnimationFrame(step);
          }, { passive: true });
          document.documentElement.addEventListener('mouseleave', function () { lantern.classList.remove('on'); shown = false; });
        }

        // Light pools follow scrolling a little: each wrapper moves on a slow, bounded sine of the
        // scroll position, so the pools never leave the screen. On book pages the pools (offset and
        // drift) stop once the title area has scrolled away, so the reading column stays calm.
        var tracks = document.querySelectorAll('.amb-pool-track');
        var isBook = document.body.classList.contains('is-book');
        var bookHead = isBook ? document.querySelector('.book-head') : null;
        var poolPending = false;
        var phases = [0, 1.7, 3.1, 4.6];
        var movePools = function () {
          poolPending = false;
          var sy = window.scrollY;
          if (bookHead) {
            var still = sy > bookHead.offsetTop + bookHead.offsetHeight;
            root.classList.toggle('amb-still', still);
            if (still) return;
          }
          tracks.forEach(function (t, i) {
            var y = Math.sin(sy / 700 + phases[i]) * 70 * motion;
            t.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)';
          });
        };
        addEventListener('scroll', function () { if (!poolPending) { poolPending = true; requestAnimationFrame(movePools); } }, { passive: true });
        movePools();

        // Edge figures: a gentle parallax, at most 60 px x --motion over the whole page. The figure
        // is 80 px taller than the screen, so its ends never come into view.
        if (figures.length) {
          var figPending = false;
          var moveFigures = function () {
            figPending = false;
            var max = document.documentElement.scrollHeight - innerHeight;
            var y = max > 0 ? -(window.scrollY / max) * 60 * motion : 0;
            figures.forEach(function (f) { f.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)'; });
            if (heroEl) cut();
          };
          addEventListener('scroll', function () { if (!figPending) { figPending = true; requestAnimationFrame(moveFigures); } }, { passive: true });
          moveFigures();
        }

        // Hero parallax: the image moves a little slower than the page while the hero is visible.
        var heroImg = document.querySelector('.hero-img');
        if (heroImg) {
          var hero = heroImg.closest('.hero');
          var pending = false;
          var update = function () {
            pending = false;
            var sy = window.scrollY;
            if (sy > hero.offsetHeight + 200) return;
            heroImg.style.transform = 'translate3d(0,' + (sy * 0.25 * motion).toFixed(1) + 'px,0)';
          };
          addEventListener('scroll', function () { if (!pending) { pending = true; requestAnimationFrame(update); } }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
