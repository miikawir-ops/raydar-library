      "Bash(gh run watch *)",
      "Bash(gh run list *)",
      "PowerShell(npm run build)",
      "PowerShell(npm run dev *)",
      "PowerShell(npm run preview *)",
      "PowerShell(git status *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push)",
      "PowerShell(git push origin main)",
      "PowerShell(gh run watch *)",
